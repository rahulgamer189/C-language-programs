//**WAP TO PRINT the number**//  
//**1. from 1 to n **//
//**2. from n to 1 **//
//**3. sum of numbers from 1 to n **//
//**4. cube of each number from 1 to n **//
//**5. sum of even and odd numbers from 1 to n **//
//**6. all a series 1 4 9 16 ..... **//
//**7. the table of given numbers **//
//**8. factorial of given number **//
//**9. check wether the given number is prime or not **//
//**10. print the fibonacci series up to n terms**//

#include <stdio.h>
int main()
{
    int choice, n, i, sum = 0, sum_even = 0, sum_odd = 0;
    long long factorial = 1;
    int t1 = 0, t2 = 1, nextTerm;
    int isPrime = 1; // Assume the number is prime

    printf("=== MENU BASED PROGRAM ===\n");
    printf("1. Print 1 to n\n");
    printf("2. Print n to 1\n");
    printf("3. Sum of numbers from 1 to n\n");
    printf("4. Cube of each number from 1 to n\n");
    printf("5. Sum of even and odd numbers from 1 to n\n");
    printf("6. Print series: 1, 4, 9, 16...\n");
    printf("7. Table of a given number\n");
    printf("8. Factorial of a given number\n");
    printf("9. Check if a number is prime\n");
    printf("10. Print Fibonacci series up to n terms\n");
    printf("Enter your choice (1-10): ");
    scanf("%d", &choice);

    if (choice >= 1 && choice <= 10) 
    {
        printf("Enter a number (n): ");
        scanf("%d", &n);
    }
    switch(choice)
    {
        case 1:
            printf("Numbers from 1 to %d:\n", n);
            for(i = 1; i <= n; i++)
                printf("%d ", i);
            printf("\n");
            break;
        case 2:
            printf("Numbers from %d to 1:\n", n);
            for(i = n; i >= 1; i--)
                printf("%d ", i);
            printf("\n");
            break;
        case 3:
            for(i = 1; i <= n; i++)
                sum += i;
            printf("Sum of numbers from 1 to %d: %d\n", n, sum);
            break;
        case 4:
            printf("Cubes of numbers from 1 to %d:\n", n);
            for(i = 1; i <= n; i++)
                printf("%d^3 = %d\n", i, i*i*i);
            break;
        case 5:
            for(i = 1; i <= n; i++) 
            {
                if(i % 2 == 0)
                    sum_even += i;
                else
                    sum_odd += i;
            }
            printf("Sum of even numbers from 1 to %d: %d\n", n, sum_even);
            printf("Sum of odd numbers from 1 to %d: %d\n", n, sum_odd);
            break;
        case 6:
            printf("Series: ");
            for(i = 1; i <= n; i++)
                printf("%d ", i*i);
            printf("\n");
            break;
        case 7:
            printf("Table of %d:\n", n);
            for(i = 1; i <= 10; i++)
                printf("%d x %d = %d\n", n, i, n*i);
            break;
        case 8:
            for(i = 1; i <= n; i++)
                factorial *= i;
            printf("Factorial of %d: %lld\n", n, factorial);
            break;
        case 9:
            if(n <= 1) 
            {
                isPrime = 0;
            } else 
            {
                for(i = 2; i <= n/2; ++i) 
                {
                    if(n % i == 0) 
                    {
                        isPrime = 0;
                        break;
                    }
                }
            }
            if(isPrime)
                printf("%d is a prime number.\n", n);
            else
                printf("%d is not a prime number.\n", n);
        case 10:
            printf("Fibonacci series up to %d terms:\n", n);
            for(i = 1; i <= n; ++i)
            {
                printf("%d ", t1);
                nextTerm = t1 + t2;
                t1 = t2;
                t2 = nextTerm;
            }
            printf("\n");
            break;
    }
    return 0;
}
