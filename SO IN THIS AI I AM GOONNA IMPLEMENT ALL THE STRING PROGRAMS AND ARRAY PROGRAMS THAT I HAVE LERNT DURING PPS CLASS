#include <stdio.h>

void readLine(char str[], int size) 
{
    int i = 0;
    char ch;
    while ((ch = getchar()) == '\n' || ch == EOF);
    if (ch != EOF) 
    {
        str[i++] = ch;
    }
    while (i < size - 1 && (ch = getchar()) != '\n' && ch != EOF) 
    {
        str[i++] = ch;
    }
    str[i] = '\0';
}

// 1. Length of a string
int strLength(char str[]) 
{
    int len = 0;
    while (str[len] != '\0') 
    {
        len++;
    }
    return len;
}

// 2. Copy string
void strCopy(char dest[], char src[]) 
{
    int i = 0;
    while (src[i] != '\0') 
    {
        dest[i] = src[i];
        i++;
    }
    dest[i] = '\0';
}

// 3. Concatenate strings
void strConcat(char dest[], char src[]) 
{
    int i = 0, j = 0;
    while (dest[i] != '\0') i++;
    while (src[j] != '\0') 
    {
        dest[i] = src[j];
        i++;
        j++;
    }
    dest[i] = '\0';
}

// 4. Reverse string
void strReverse(char str[]) 
{
    int len = strLength(str);
    for (int i = 0; i < len / 2; i++) 
    {
        char temp = str[i];
        str[i] = str[len - 1 - i];
        str[len - 1 - i] = temp;
    }
}

// 5. Palindrome check
int isPalindrome(char str[]) 
{
    int len = strLength(str);
    for (int i = 0; i < len / 2; i++) 
    {
        if (str[i] != str[len - 1 - i]) return 0;
    }
    return 1;
}

// 6. Count vowels
int countVowels(char str[]) 
{
    int count = 0;
    for (int i = 0; str[i] != '\0'; i++) 
    {
        char ch = str[i];
        if (ch == 'a' || ch == 'e' || ch == 'i' || ch == 'o' || ch == 'u' ||
            ch == 'A' || ch == 'E' || ch == 'I' || ch == 'O' || ch == 'U') 
            
        {
            count++;
        }
    }
    return count;
}

// 7. Toggle case (Upper to lower and vice versa)
void toggleCase(char str[]) 
{
    for (int i = 0; str[i] != '\0'; i++) 
    {
        if (str[i] >= 'A' && str[i] <= 'Z') 
        {
            str[i] += 32;
        } else if (str[i] >= 'a' && str[i] <= 'z') 
        {
            str[i] -= 32;
        }
    }
}

// 8. Count alphabets, digits, and symbols
void countCharacters(char str[], int *alpha, int *digit, int *symbol) 
{
    *alpha = *digit = *symbol = 0;
    for (int i = 0; str[i] != '\0'; i++) 
    {
        if ((str[i] >= 'a' && str[i] <= 'z') || (str[i] >= 'A' && str[i] <= 'Z')) 
        {
            (*alpha)++;
        } else if (str[i] >= '0' && str[i] <= '9') 
        {
            (*digit)++;
        } else if (str[i] != ' ' && str[i] != '\t') 
        {
            (*symbol)++;
        }
    }
}

// 9. Count words in a sentence
int countWords(char str[]) 
{
    int count = 0, inWord = 0;
    for (int i = 0; str[i] != '\0'; i++) 
    {
        if (str[i] != ' ' && str[i] != '\t') 
        {
            if (!inWord) 
            {
                count++;
                inWord = 1;
            }
        } else 
        {
            inWord = 0;
        }
    }
    return count;
}

// 10. Compare two strings
int strCompare(char s1[], char s2[]) 
{
    int i = 0;
    while (s1[i] != '\0' && s2[i] != '\0') 
    {
        if (s1[i] != s2[i]) return s1[i] - s2[i];
        i++;
    }
    return s1[i] - s2[i];
}

// 11. Extract substring
void extractSubstring(char str[], int start, int len, char sub[]) 
{
    int i = 0;
    while (i < len && str[start + i] != '\0') 
    {
        sub[i] = str[start + i];
        i++;
    }
    sub[i] = '\0';
}

// 12. Find occurrence of substring
int findSubstring(char str[], char sub[], int *firstIndex) 
{
    int count = 0;
    *firstIndex = -1;
    for (int i = 0; str[i] != '\0'; i++) 
    {
        int j = 0;
        while (sub[j] != '\0' && str[i + j] == sub[j]) 
        {
            j++;
        }
        if (sub[j] == '\0') 
        {
            if (*firstIndex == -1) *firstIndex = i;
            count++;
        }
    }
    return count;
}

// 13. Print all subsets/substrings
void printAllSubsets(char str[]) 
{
    int len = strLength(str);
    for (int i = 0; i < len; i++) 
    {
        for (int j = i; j < len; j++) 
        {
            for (int k = i; k <= j; k++) 
            {
                printf("%c", str[k]);
            }
            printf("\n");
        }
    }
}

