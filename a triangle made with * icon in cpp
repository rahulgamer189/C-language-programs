 #include <iostream>                                        
  using namespace std;                                         
  int main() 
  {                                               
       int n = 6;                                             
       char ch = '*';                                         
       for (int i = 1; i <= n; i++) {            // each row |
           for (int j = 1; j <= n - i; j++)      // leading spaces |
               cout << "  ";                                  
           for (int k = 1; k <= 2 * i - 1; k++)  // stars grow by 2 each row |
               cout << ch << " ";                             
           cout << endl;                                      
       }                                                      
       return 0;                                              
    }
