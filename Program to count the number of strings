//** WAP to count the number of strings **//
#include <stdio.h>
#include <string.h>
#include <ctype.h>

int main()
{
    char str[100];
    int count = 0;

    printf("Enter a string: ");
    fgets(str, sizeof(str), stdin);

    for (int i = 0; str[i] != '\0'; i++) 
    {
        if (isspace(str[i])) 
        {
            count++;
        }
    }

    printf("Number of strings: %d\n", count + 1);

    return 0;
}
